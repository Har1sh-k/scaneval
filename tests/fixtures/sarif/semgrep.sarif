            {
              "id": "build.rules.python.probe.subprocess-shell",
              "name": "build.rules.python.probe.subprocess-shell",
              "shortDescription": {"text": "Semgrep Finding: build.rules.python.probe.subprocess-shell"},
              "fullDescription": {"text": "subprocess call with shell=True"},
              "help": {"text": "subprocess call with shell=True", "markdown": "subprocess call with shell=True"},
              "defaultConfiguration": {"level": "warning"},
              "properties": {"precision": "very-high", "tags": ["CWE-78: OS Command Injection", "security"]}
            }
          ]
        }
      },
      "invocations": [
        {"executionSuccessful": true, "toolExecutionNotifications": []}
      ],
      "results": [
        {
          "ruleId": "build.rules.python.probe.subprocess-shell",
          "message": {"text": "subprocess call with shell=True"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/app.py", "uriBaseId": "%SRCROOT%"},
                "region": {"startLine": 5, "startColumn": 12, "endLine": 5, "endColumn": 43, "snippet": {"text": "    return subprocess.run(cmd, shell=True)"}}
              }
            }
          ],
          "fingerprints": {"matchBasedId/v1": "requires login"},
          "properties": {}
        },
        {
