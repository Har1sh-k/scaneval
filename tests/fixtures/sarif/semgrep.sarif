  "version": "2.1.0",
  "runs": [
    {
      "properties": {
        "fixture": "Fabricated for ScanEval tests in the shape Semgrep OSS 1.177 writes with --sarif; not the output of a real scan."
      },
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
