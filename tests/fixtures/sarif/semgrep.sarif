              "help": {"text": "SQL built with string formatting from request data", "markdown": "SQL built with string formatting from request data"},
              "defaultConfiguration": {"level": "error"},
              "properties": {"precision": "very-high", "tags": ["CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')", "security"]}
