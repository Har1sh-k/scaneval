{
  "name": "@scaneval/observer",
  "version": "0.1.0-alpha.1",
  "description": "Opt-in observer protocol emitter for ScanEval harnesses",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Har1sh-k/scaneval.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/Har1sh-k/scaneval/tree/main/sdk/typescript#readme",
  "bugs": {"url": "https://github.com/Har1sh-k/scaneval/issues"},
  "engines": {"node": ">=22"},
  "publishConfig": {"access": "public", "tag": "next"},
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node test/package-smoke.mjs"
  },
  "devDependencies": {
    "tsx": "4.22.0",
    "typescript": "5.9.3"
  }
}
