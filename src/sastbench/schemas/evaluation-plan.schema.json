{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sastbench.dev/schemas/v2/evaluation-plan.schema.json",
  "title": "SASTbench evaluation plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "input_hash", "scope", "targets", "controls", "review_budgets"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {"enum": ["diagnostic", "reviewed"]},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "review_budgets": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    }
  },
  "$defs": {
    "validation_level": {"enum": ["fixture", "L1", "L2", "L3", "L4"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "description", "validation_level"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "validation_level": {"$ref": "#/$defs/validation_level"},
        "kind": {"type": "string", "minLength": 1}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["control_id", "description", "type", "validation_level"],
      "properties": {
        "control_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "type": {"enum": ["capability_safe", "fixed_target", "both"]},
        "validation_level": {"$ref": "#/$defs/validation_level"},
        "target_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
