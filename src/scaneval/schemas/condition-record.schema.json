{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaneval.dev/schemas/v2/condition-record.schema.json",
  "title": "ScanEval evaluation condition evidence",
  "description": "Deterministic classification of exact saved invocation artifacts. Attestation is an evidence state, never a claim about pretrained model memory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "condition", "status", "identity_profile", "history", "retrieval", "network", "provider_retrieval", "run_id", "invocation_id", "system_id", "input_hash", "policy_sha256", "artifacts", "bindings", "retained_identity_cues", "assurance", "provider", "details", "reasons"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "condition": {"enum": ["closed_book_standard", "open_context", "identity_reduced"]},
    "status": {"enum": ["attested", "declared_only", "failed", "unavailable"]},
    "declared": {"type": "boolean", "description": "Whether a condition was explicitly configured, rather than conservatively inferred from saved evidence."},
    "identity_profile": {"type": "string", "minLength": 1},
    "mode": {"enum": ["full", "pr"]},
    "history": {"enum": ["original_absent", "neutral_synthetic", "bounded_ancestor_history", "unexpected", "unavailable"]},
    "retrieval": {"enum": ["disabled", "observed_none", "capture_gap", "enabled", "recorded", "unavailable"]},
    "network": {"enum": ["enforced", "unenforced"]},
    "provider_retrieval": {"enum": ["disabled", "unverifiable", "not_applicable", "enabled"]},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "system_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bindings": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "artifacts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"],
      "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    }},
    "retained_identity_cues": {"type": "object"},
    "assurance": {"type": "object", "additionalProperties": false, "required": ["network", "retrieval", "provider"], "properties": {
      "network": {"enum": ["declared", "external_enforcement"]},
      "retrieval": {"enum": ["capture_gap", "tool_enabled", "tool_disabling", "complete_observation", "recorded", "self_report"]},
      "provider": {"type": "string"},
      "identity": {"enum":["saved_manifest_verified","unavailable"]}
    }},
    "provider": {"type": "object"},
    "details": {"type": "object"},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}}
  }
}
