{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine static-label judgments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_kind", "scope", "provenance", "judgments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_kind": {"const": "machine"},
    "scope": {"const": "static_labels"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_model", "reported_model", "identity_basis", "identity_ambiguous", "run_id", "receipt_path", "receipt_sha256", "prompt_path", "prompt_sha256", "reviewed_at"],
      "properties": {
        "requested_model": {"type": "string", "minLength": 1},
        "reported_model": {"type": "string", "minLength": 1},
        "identity_basis": {"enum": ["orchestrator_task_metadata", "provider_receipt", "self_reported", "unknown"]},
        "identity_ambiguous": {"type": "boolean"},
        "run_id": {"type": "string", "minLength": 1},
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_path": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_at": {"type": "string", "minLength": 1}
      }
    },
    "judgments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "packet_sha256", "verdict", "rationale", "criteria", "citations", "blockers", "limitations"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "packet_sha256": {"$ref": "#/$defs/sha256"},
          "verdict": {"enum": ["accept", "revise", "abstain"]},
          "rationale": {"type": "string", "minLength": 1},
          "criteria": {
            "type": "object", "additionalProperties": false,
            "required": ["identity", "pin", "mapping", "locations", "mechanism", "severity"],
            "properties": {
              "identity": {"$ref": "#/$defs/criterion"},
              "pin": {"$ref": "#/$defs/criterion"},
              "mapping": {"$ref": "#/$defs/criterion"},
              "locations": {"$ref": "#/$defs/criterion"},
              "mechanism": {"$ref": "#/$defs/criterion"},
              "severity": {"$ref": "#/$defs/criterion"}
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["artifact_id", "start_line", "end_line"],
              "properties": {
                "artifact_id": {"type": "string", "minLength": 1},
                "start_line": {"type": "integer", "minimum": 1},
                "end_line": {"type": "integer", "minimum": 1}
              }
            }
          },
          "blockers": {"$ref": "#/$defs/strings"},
          "limitations": {"$ref": "#/$defs/strings"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "criterion": {"enum": ["supported", "unsupported", "uncertain"]},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
