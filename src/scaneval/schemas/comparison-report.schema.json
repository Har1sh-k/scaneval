                  "target_observations": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "detected_without_rank": {
              "type": "integer",
              "minimum": 0
            },
            "not_detected": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "slices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slice_block"
          }
        }
      }
