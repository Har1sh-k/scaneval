            "capability_safe": {
              "$ref": "#/$defs/control"
            },
            "fixed_target": {
              "$ref": "#/$defs/control"
            }
          }
        },
        "completion": {
          "$ref": "#/$defs/completion"
        },
        "claims": {
          "$ref": "#/$defs/claims"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      }
