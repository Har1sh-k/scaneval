    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "status",
        "created_at",
        "manifest_sha256",
        "schedule_sha256",
        "config_sha256",
        "evidence_sha256",
        "pack",
        "repetitions",
        "inputs",
        "systems",
        "assignments",
        "bundles",
        "failures",
        "timing"
      ],
      "description": "One run directory as read, bound by canonical hashes of its manifest, its schedule, its configuration, and every assignment's evidence digests.",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schedule_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pack": {
          "$ref": "#/$defs/pack"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "inputs": {
          "type": "integer",
          "minimum": 0
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assignments": {
          "type": "integer",
          "minimum": 0
        },
        "bundles": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "$ref": "#/$defs/failure_counts"
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_records",
            "records_without_timestamps",
            "elapsed_wall_seconds",
            "summed_wall_seconds"
          ],
          "description": "Elapsed wall time is the span from the earliest start to the latest finish the execution records state; summed wall time adds every record's own wall time.",
          "properties": {
            "execution_records": {
              "type": "integer",
              "minimum": 0
            },
            "records_without_timestamps": {
              "type": "integer",
              "minimum": 0
            },
            "elapsed_wall_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "summed_wall_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "adapter",
        "model_id",
        "model_revision",
        "config_sha256",
        "network_policy",
        "execution",
        "runs"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "network_policy": {
          "enum": [
            "none",
            "model_provider_only",
            "unrestricted"
          ]
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "enforced_expected",
            "image"
          ],
          "properties": {
            "backend": {
              "enum": [
                "local",
                "oci"
              ]
            },
            "enforced_expected": {
              "type": "boolean"
            },
            "image": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "detection_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
