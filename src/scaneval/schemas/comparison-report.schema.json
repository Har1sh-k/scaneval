    "view_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "evidence_scope",
        "observations",
        "first_hit_ranks",
        "slices"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_scope": {
          "enum": [
            "diagnostic",
            "draft",
            "reviewed"
          ]
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignments",
            "bundles",
            "statuses",
            "failures",
            "failed_assignments",
            "review_states",
            "unscored_items",
            "unregistered_items"
          ],
          "properties": {
            "assignments": {
              "type": "integer",
              "minimum": 0
            },
            "bundles": {
              "type": "integer",
              "minimum": 0
            },
            "statuses": {
              "$ref": "#/$defs/status_counts"
            },
            "failures": {
              "$ref": "#/$defs/failure_counts"
            },
            "failed_assignments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run_id",
                  "assignment_id",
                  "reason"
                ],
                "properties": {
                  "run_id": {
                    "type": "string",
                    "minLength": 1
                  },
