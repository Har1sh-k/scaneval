    "slice_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice",
        "canonical_targets",
        "canonical_controls",
        "inputs",
        "clusters",
        "detection",
        "controls",
        "completion",
        "claims",
        "usage"
      ],
      "properties": {
        "slice": {
          "$ref": "#/$defs/slice"
        },
        "canonical_targets": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_controls": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "integer",
          "minimum": 0
        },
        "clusters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targets",
            "pairs",
            "controls"
          ],
          "description": "The resampling clusters of each family: those carrying the slice's targets (recall and recall@B), those carrying a target with a frozen pair (pair correctness), and those carrying its controls (control metrics).",
          "properties": {
            "targets": {
              "type": "integer",
              "minimum": 0
            },
            "pairs": {
              "type": "integer",
              "minimum": 0
            },
            "controls": {
              "type": "integer",
              "minimum": 0
            }
          }
