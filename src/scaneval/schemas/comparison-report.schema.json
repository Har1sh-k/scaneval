                  "null"
                ]
              },
              "lower_bound": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "interval": {
                "$ref": "#/$defs/interval"
              }
            }
          }
        },
        "pair_correctness": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/difference"
            }
          ]
        },
        "pair_availability": {
          "type": [
            "number",
            "null"
          ]
        },
        "completed_mass": {
          "type": [
            "number",
            "null"
          ]
        },
        "assessable_mass": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "control_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_rate",
        "completed_upper",
        "completed_mass",
        "assessable_mass"
      ],
      "properties": {
        "resolved_rate": {
          "$ref": "#/$defs/difference"
        },
        "completed_upper": {
          "$ref": "#/$defs/difference"
        },
        "completed_mass": {
          "type": [
            "number",
            "null"
          ]
        },
        "assessable_mass": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "slice_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice",
        "detection",
        "controls",
        "completion"
      ],
      "properties": {
        "slice": {
          "$ref": "#/$defs/slice"
        },
        "detection": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection_difference"
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability_safe",
            "fixed_target"
          ],
          "properties": {
            "capability_safe": {
              "$ref": "#/$defs/control_difference"
            },
            "fixed_target": {
              "$ref": "#/$defs/control_difference"
            }
          }
        },
        "completion": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
