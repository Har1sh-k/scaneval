        "first_hit_ranks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ranks",
            "detected_without_rank",
            "not_detected"
          ],
          "description": "Unweighted target observations by first accepted rank; a detection without a measured native rank is counted apart and is never given one.",
          "properties": {
            "ranks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rank",
                  "target_observations"
                ],
                "properties": {
                  "rank": {
                    "type": "integer",
                    "minimum": 1
