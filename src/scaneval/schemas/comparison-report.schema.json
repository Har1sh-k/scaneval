                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "enum": [
                      "failed_preparation",
                      "skipped_system",
                      "skipped",
                      "missing_row",
                      "missing_bundle",
                      "unusable_bundle"
                    ]
                  }
                }
              }
            },
            "review_states": {
              "$ref": "#/$defs/review_counts"
