        "records",
        "unique",
        "duplicate_copies",
        "delivered",
        "bundles_with_unresolved_delivery",
        "unmatched_unique",
        "pending_matching"
      ],
      "description": "Claim volume summed over bundles, each bundle once. delivered sums bundles whose bundles are resolved only.",
      "properties": {
        "bundles": {
          "type": "integer",
          "minimum": 0
        },
        "assignments": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "unique": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_copies": {
          "type": "integer",
          "minimum": 0
        },
        "delivered": {
          "type": "integer",
          "minimum": 0
        },
        "bundles_with_unresolved_delivery": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_unique": {
          "type": "integer",
          "minimum": 0
        },
        "pending_matching": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundles",
        "wall_seconds",
        "setup_seconds",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "description": "Reported usage summed over bundles, each executed scan once however many targets it covers. Unknown values stay unknown and are counted, never summed as 0.",
      "properties": {
        "bundles": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known_sum",
            "known",
            "unknown"
          ],
          "properties": {
            "known_sum": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "known": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "setup_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sum",
            "reported"
          ],
          "properties": {
            "sum": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "reported": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "input_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sum",
            "reported"
          ],
          "properties": {
            "sum": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reported": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "output_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sum",
            "reported"
          ],
          "properties": {
            "sum": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reported": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cost_usd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known_sum",
            "known",
            "unknown",
            "coverage"
          ],
          "properties": {
            "known_sum": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "known": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            },
            "coverage": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
