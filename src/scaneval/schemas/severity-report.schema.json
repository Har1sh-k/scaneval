{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibrator_version",
    "pack_sha256",
    "policy",
    "policy_sha256",
    "band_order",
    "claim_selection",
    "reference_selection",
    "label_mapping",
    "cross_version_policy",
    "runs",
    "counts",
    "records",
    "views",
    "limits",
    "unplanned_assignments",
    "assignment_counts"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "calibrator_version": {
      "enum": [
        "severity-calibration-1",
        "severity-calibration-2"
      ]
    },
    "pack_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "band_order": {
      "const": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "claim_selection": {
      "type": "string"
    },
    "reference_selection": {
      "type": "string"
    },
    "label_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cross_version_policy": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "manifest_sha256",
          "schedule_sha256",
          "config_sha256",
          "frozen_pack_sha256"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "schedule_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "frozen_pack_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unplanned_assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unplanned_assignment"
      }
    },
    "assignment_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled",
        "unplanned"
      ],
      "properties": {
        "scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "unplanned": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaneval.dev/schemas/v2.1/severity-report.schema.json",
  "title": "ScanEval severity calibration report",
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "allegation",
        "kind",
        "primary_location"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "allegation": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "primary_location": {
          "$ref": "#/$defs/location"
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "native_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "native_severity": {
          "type": "string",
          "minLength": 1
        },
        "native_cwe": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "native_source_symbol": {
          "type": "string",
          "minLength": 1
        },
        "native_sink_symbol": {
          "type": "string",
          "minLength": 1
        },
        "evidence_text": {
          "type": "string"
        },
        "related_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "raw_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "claimed_cvss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "version",
            "provenance"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "version": {
              "enum": [
                "3.0",
                "3.1",
                "4.0"
              ]
            },
            "provenance": {
              "enum": [
                "native",
                "imported",
                "self_reported"
              ]
            },
            "vector": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_observations",
        "canonical_targets",
        "matched",
        "eligible_matched",
        "assessed",
        "unavailable",
        "excluded",
        "reasons"
      ],
      "properties": {
        "target_observations": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_targets": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_matched": {
          "type": "integer",
          "minimum": 0
        },
        "assessed": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "description": "Published CVSS base severity, with its source and version. This is corpus stratification metadata, not a scanner score, exploitability proof, or admission decision. Preserve source disagreements in note; never infer severity from the vulnerability kind.",
      "required": [
        "level",
        "score",
        "cvss_version",
        "vector",
        "source",
        "source_kind",
        "retrieved",
        "note"
      ],
      "properties": {
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "cvss_version": {
          "enum": [
            "3.0",
            "3.1",
            "4.0"
          ]
        },
        "vector": {
          "type": "string",
          "pattern": "^CVSS:(3\\.[01]|4\\.0)/"
        },
        "source": {
          "type": "string",
          "pattern": "^https?://"
        },
        "source_kind": {
          "enum": [
            "cna_cvss",
            "vendor_cvss",
            "github_reviewed_cvss"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "level": {
              "const": "none"
            },
            "score": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "level": {
              "const": "low"
            },
            "score": {
              "minimum": 0.1,
              "maximum": 3.9
            }
          }
        },
        {
          "properties": {
            "level": {
              "const": "medium"
            },
            "score": {
              "minimum": 4,
              "maximum": 6.9
            }
          }
        },
        {
          "properties": {
            "level": {
              "const": "high"
            },
            "score": {
              "minimum": 7,
              "maximum": 8.9
            }
          }
        },
        {
          "properties": {
            "level": {
              "const": "critical"
            },
            "score": {
              "minimum": 9,
              "maximum": 10
            }
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "cvss_version": {
              "const": "3.0"
            },
            "vector": {
              "pattern": "^CVSS:3\\.0/"
            }
          }
        },
        {
          "properties": {
            "cvss_version": {
              "const": "3.1"
            },
            "vector": {
              "pattern": "^CVSS:3\\.1/"
            }
          }
        },
        {
          "properties": {
            "cvss_version": {
              "const": "4.0"
            },
            "vector": {
              "pattern": "^CVSS:4\\.0/"
            }
          }
        }
      ]
    },
    "reference_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "severity",
        "case_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_severity",
        "claimed_cvss",
        "claimed_provenance",
        "normalized_band",
        "reference",
        "reference_band",
        "status",
        "reason",
        "outcome",
        "band_error",
        "numeric_delta",
        "numeric_reason",
        "cross_version"
      ],
      "properties": {
        "native_severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimed_cvss": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "score",
                "version",
                "provenance"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "version": {
                  "enum": [
                    "3.0",
                    "3.1",
                    "4.0"
                  ]
                },
                "provenance": {
                  "enum": [
                    "native",
                    "imported",
                    "self_reported"
                  ]
                },
                "vector": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "claimed_provenance": {
          "type": "string"
        },
        "normalized_band": {
          "anyOf": [
            {
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_band": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "assessed",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "exact",
                "overestimated",
                "underestimated"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "band_error": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -4,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "numeric_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "numeric_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_version": {
          "type": "boolean"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "weighted_numerator",
        "weighted_denominator",
        "denominator_observations",
        "denominator_targets"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "weighted_numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "weighted_denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator_observations": {
          "type": "integer",
          "minimum": 0
        },
        "denominator_targets": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "weighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weighting",
        "counts",
        "unavailable_reason",
        "notes",
        "weights",
        "metrics"
      ],
      "properties": {
        "weighting": {
          "enum": [
            "equal_target",
            "equal_project",
            "equal_family",
            "explicit"
          ]
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment_coverage",
            "exact_band_agreement",
            "overestimation",
            "underestimation",
            "mean_absolute_band_error",
            "numeric_bias",
            "numeric_mean_absolute_error",
            "band_error_-4",
            "band_error_-3",
            "band_error_-2",
            "band_error_-1",
            "band_error_0",
            "band_error_1",
            "band_error_2",
            "band_error_3",
            "band_error_4"
          ],
          "properties": {
            "assessment_coverage": {
              "$ref": "#/$defs/metric"
            },
            "exact_band_agreement": {
              "$ref": "#/$defs/metric"
            },
            "overestimation": {
              "$ref": "#/$defs/metric"
            },
            "underestimation": {
              "$ref": "#/$defs/metric"
            },
            "mean_absolute_band_error": {
              "$ref": "#/$defs/metric"
            },
            "numeric_bias": {
              "$ref": "#/$defs/metric"
            },
            "numeric_mean_absolute_error": {
              "$ref": "#/$defs/metric"
            },
            "band_error_-4": {
              "$ref": "#/$defs/metric"
            },
            "band_error_-3": {
              "$ref": "#/$defs/metric"
            },
            "band_error_-2": {
              "$ref": "#/$defs/metric"
            },
            "band_error_-1": {
              "$ref": "#/$defs/metric"
            },
            "band_error_0": {
              "$ref": "#/$defs/metric"
            },
            "band_error_1": {
              "$ref": "#/$defs/metric"
            },
            "band_error_2": {
              "$ref": "#/$defs/metric"
            },
            "band_error_3": {
              "$ref": "#/$defs/metric"
            },
            "band_error_4": {
              "$ref": "#/$defs/metric"
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "mode",
        "profile",
        "condition",
        "condition_status",
        "counts",
        "weightings",
        "by_cvss_version",
        "evidence_scope",
        "unplanned_assignments",
        "unplanned_assignment_count"
      ],
      "properties": {
        "system_id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "condition_status": {
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "weightings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weighting"
          }
        },
        "by_cvss_version": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/weighting"
            }
          }
        },
        "evidence_scope": {
          "type": "string"
        },
        "unplanned_assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unplanned_assignment"
          }
        },
        "unplanned_assignment_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "mode",
        "profile",
        "condition",
        "condition_status",
        "run_id",
        "input_id",
        "assignment_id",
        "canonical_id",
        "repetition",
        "target_ids",
        "status",
        "reason",
        "matched",
        "selected_claim",
        "accepted_claim_ids",
        "references",
        "comparison",
        "bindings",
        "evidence_scope"
      ],
      "properties": {
        "system_id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "condition_status": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "input_id": {
          "type": "string"
        },
        "assignment_id": {
          "type": "string"
        },
        "canonical_id": {
          "type": "string"
        },
        "repetition": {
          "type": "integer",
          "minimum": 0
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "assessed",
            "unavailable",
            "excluded"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched": {
          "type": "boolean"
        },
        "selected_claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/claim"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference_entry"
          }
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/comparison"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targets_sha256",
            "references_sha256"
          ],
          "properties": {
            "targets_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "references_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "decisions_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "review_record_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "evidence_scope": {
          "type": "string"
        }
      }
    },
    "unplanned_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "input_id",
        "system_id",
        "assignment_id",
        "mode",
        "profile",
        "condition",
        "condition_status",
        "evidence_scope",
        "reason",
        "detail",
        "repetition"
      ],
      "properties": {
