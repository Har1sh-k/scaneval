{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScanEval dataset adapter output v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "mode", "source", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"$ref": "#/$defs/id"},
    "mode": {"enum": ["pr-review", "cve-detection"]},
    "source": {
      "type": "object", "required": ["name", "revision", "license"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {"type": "object"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "location": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "side": {"enum": ["base", "head", "snapshot"]},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["annotation_id", "label", "text", "locations", "category", "severity"],
      "properties": {
        "annotation_id": {"$ref": "#/$defs/id"},
        "label": {"enum": ["positive", "negative", "fixed-control"]},
        "text": {"type": "string", "minLength": 1},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "category": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low", "informational", "unspecified"]},
        "metadata": {"type": "object"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "case_id", "repository_url", "commit", "variant", "languages", "annotations"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"},
        "repository_url": {"type": "string", "minLength": 1},
        "mirror_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "commit": {"$ref": "#/$defs/commit"}, "base_commit": {"$ref": "#/$defs/commit"},
        "variant": {"enum": ["pr", "vulnerable", "fixed"]},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
        "metadata": {"type": "object"}
      }
    }
  }
}
