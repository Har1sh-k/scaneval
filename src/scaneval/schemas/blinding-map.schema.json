{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaneval.dev/schemas/v2/blinding-map.schema.json",
  "title": "ScanEval identity transformation map",
  "description": "A reviewed, per-repository map for the metadata_blinded and identity_reduced input profiles. It names identity tokens and their pseudonyms, the snapshot variants it covers, each file edit, and any identity-only documentation or instruction file removed by identity_reduced. Every operation is pinned to the exact original bytes in every variant. Evaluator-side: it never enters a scanner workspace. It never changes or removes source, dependencies, licenses, build, CI, or security configuration, and it is not anonymization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "map_id",
    "map_version",
    "repository",
    "pseudonyms",
    "variants",
    "edits",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "map_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Stable id of this map. Related transformed inputs of one repository use one map id and content digest within each profile; different profiles can name different maps."
    },
    "map_version": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "name"
      ],
      "description": "The repository every variant is fetched from; it must be the pack snapshot's repository URL exactly.",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pseudonyms": {
      "type": "array",
      "minItems": 1,
      "description": "Identity tokens and their replacements. Neither side may be blank or hold a line break; originals are unique, replacements are unique, no replacement contains an original, and no original contains another pseudonym's replacement, all ignoring case.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "original",
          "replacement"
        ],
        "properties": {
          "original": {
            "type": "string",
            "minLength": 1
          },
          "replacement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "description": "The snapshots this map covers, each pinned by commit and by the tree hash of its original export. A map applied to a snapshot pinned or exported differently is stale and refused.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot_id",
          "commit",
          "tree_hash"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tree_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "edits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edit"
      }
    },
    "removals": {
      "type": "array",
      "description": "Files identity_reduced removes after review. metadata_blinded refuses any map with removals. Only identity-only documentation and scanner instruction files are eligible; source, dependencies, licenses, build, CI, and security material are never eligible.",
      "items": {
        "$ref": "#/$defs/removal"
      }
    },
    "identity_policy": {
      "type": "object",
      "description": "Explicit strict identity-reduced condition policy. Its declarations are part of the reviewed map digest; legacy maps without it remain basic exports only.",
      "additionalProperties": false,
      "required": ["policy_id", "version", "answer_aliases"],
      "properties": {
        "policy_id": {"const": "scaneval.identity-reduced"},
        "version": {"const": "1"},
        "answer_aliases": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["category", "value"],
          "properties": {
            "category": {"enum": ["target_alias", "advisory_url", "answer_alias"]},
            "value": {"type": "string", "minLength": 1},
            "forms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }},
        "instruction_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "identity_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_artifacts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["category"],
          "anyOf": [{"required": ["path"]}, {"required": ["sha256"]}],
          "properties": {
            "category": {"enum": ["evaluator_evidence", "redaction_dictionary", "transformation_manifest"]},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }}
      }
    },
    "metadata_edits": {
      "type": "array", "items": {"$ref": "#/$defs/metadata_edit"},
      "description": "Strict identity policy only: reviewed hash-pinned edits to supported identity-only package URL leaves. Dependency/runtime fields and arbitrary selectors are refused."
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "reviews_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Where the review chain ends: the chain_sha256 of the last review, present exactly when a review is recorded."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "metadata_edit": {
      "type": "object", "additionalProperties": false,
      "required": ["edit_id", "path", "field_path", "replacement", "role_check", "rationale", "expected"],
      "properties": {
        "edit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "path": {"type": "string", "minLength": 1},
        "field_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "replacement": {"type": "string"},
        "role_check": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "expected": {"type": "array", "minItems": 1, "items": {"oneOf": [
          {"$ref": "#/$defs/metadata_present"}, {"$ref": "#/$defs/absent"}
        ]}}
      }
    },
    "metadata_present": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "state", "file_sha256", "original"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1}, "state": {"const": "present"},
        "file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "original": {"type": "string", "minLength": 1}, "raw_token": {"type": "string", "minLength": 1}
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit_id",
        "path",
        "role",
        "rationale",
        "replacements",
        "expected"
      ],
      "properties": {
        "edit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "One file, as a normalized relative POSIX path in the export."
        },
        "role": {
          "enum": [
            "documentation_identifier",
            "non_runtime_branding",
            "display_metadata"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "role_check": {
          "type": "string",
          "minLength": 1,
          "description": "Why the edited field is not read at runtime. Required for display_metadata."
        },
        "replacements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The declared originals this edit replaces in its file, every occurrence of each."
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per variant: the file's exact hash and the occurrence count of each replaced original, or that the file is absent.",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/present"
              },
              {
                "$ref": "#/$defs/absent"
              }
            ]
          }
        }
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removal_id",
        "path",
        "role",
        "rationale",
        "expected"
      ],
      "properties": {
        "removal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "One file, as a normalized relative POSIX path in the original export."
        },
        "role": {
          "enum": [
            "identity_document",
            "instruction_file"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why removing this file reduces repository identity without removing code or scoring evidence."
        },
        "role_check": {
          "type": "string", "minLength": 1,
          "description": "Explicit strict-policy review that advisory prose has no runtime, security-configuration, or scoring role; required for the narrow security-advisory prose exception."
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per variant: the file's exact hash, or that the file is absent.",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/removal_present"
              },
              {
                "$ref": "#/$defs/absent"
              }
            ]
          }
        }
      }
    },
    "removal_present": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "state",
        "file_sha256"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "present"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "present": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "state",
        "file_sha256",
        "occurrences"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "present"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "occurrences": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "state"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "absent"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "role",
        "decision",
        "at",
        "note",
        "content_sha256",
        "chain_sha256"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "curator",
            "independent_reviewer"
          ]
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "unresolved"
          ],
          "description": "The latest review is the operative one: a map is applied only when it approves and its content_sha256 is the map's current content digest."
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The digest of the map without its reviews, as the reviewer saw it."
        },
        "chain_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "This review's place in the chain: its own fields and the chain value of the review before it, computed by scaneval.contracts.chain_digest with kind blinding_review. Not a signature; it makes a quiet deletion visible."
        }
      }
    }
  }
}
